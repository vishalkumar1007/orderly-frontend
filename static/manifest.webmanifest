{
	"name": "Orderly — Shop Admin",
	"short_name": "Orderly",
	"description": "Run your shop: live orders, menu, branding and your storefront.",
	"id": "/shop",
	"start_url": "/shop",
	"scope": "/",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui", "browser"],
	"orientation": "portrait-primary",
	"background_color": "#f7f8fb",
	"theme_color": "#6366f1",
	"categories": ["business", "food", "productivity"],
	"icons": [
		{
			"src": "/icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Live orders",
			"short_name": "Orders",
			"url": "/shop/orders",
			"icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
		},
		{
			"name": "Kitchen board",
			"short_name": "Kitchen",
			"url": "/kitchen",
			"icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
		},
		{
			"name": "Menu",
			"short_name": "Menu",
			"url": "/shop/menu",
			"icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
		}
	]
}
