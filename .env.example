# Dev (recommended): leave unset — Vite proxies /api → http://127.0.0.1:8080
# Or set explicitly for absolute API hosts:
#   PUBLIC_API_URL=http://api.localhost:8080
#     → platform: http://api.localhost:8080
#     → shop:     http://{slug}.api.localhost:8080
# Production:
#   PUBLIC_API_URL=https://api.orderly.qd.je
PUBLIC_API_URL=
PUBLIC_BASE_DOMAIN=localhost
